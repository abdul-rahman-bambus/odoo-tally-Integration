<odoo>
    <record id="action_tally_config" model="ir.actions.act_window">
        <field name="name">Tally Configurations</field>
        <field name="res_model">tally.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tally_mapping" model="ir.actions.act_window">
        <field name="name">Tally Mappings</field>
        <field name="res_model">tally.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tally_sync_queue" model="ir.actions.act_window">
        <field name="name">Tally Sync Queue</field>
        <field name="res_model">tally.sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tally_bridge_root" name="Tally Bridge" sequence="10" groups="tally_bridge.group_tally_bridge_user"/>
    <menuitem id="menu_tally_bridge_configuration" name="Configuration" parent="menu_tally_bridge_root" sequence="10" groups="tally_bridge.group_tally_bridge_manager"/>
    <menuitem id="menu_tally_bridge_operations" name="Operations" parent="menu_tally_bridge_root" sequence="20" groups="tally_bridge.group_tally_bridge_user"/>

    <menuitem id="menu_tally_config" name="Configurations" parent="menu_tally_bridge_configuration" action="action_tally_config" sequence="10" groups="tally_bridge.group_tally_bridge_manager"/>
    <menuitem id="menu_tally_mapping" name="Mappings" parent="menu_tally_bridge_configuration" action="action_tally_mapping" sequence="20" groups="tally_bridge.group_tally_bridge_manager"/>
    <menuitem id="menu_tally_sync_queue" name="Sync Queue" parent="menu_tally_bridge_operations" action="action_tally_sync_queue" sequence="10" groups="tally_bridge.group_tally_bridge_user"/>
</odoo>
