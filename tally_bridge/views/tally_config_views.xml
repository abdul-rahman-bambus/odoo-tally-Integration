<odoo>
    <record id="view_tally_config_tree" model="ir.ui.view">
        <field name="name">tally.config.tree</field>
        <field name="model">tally.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="agent_url"/>
                <field name="batch_limit"/>
                <field name="retry_limit"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>
